# Copier vers .env puis renseigner. Ne jamais committer .env.
LOCAL_UID=1000
LOCAL_GID=1000
POSTGRES_USER=lsv
POSTGRES_PASSWORD=
POSTGRES_DB=lsv
DATABASE_URL=postgres://lsv:<POSTGRES_PASSWORD>@db:5432/lsv
