# À COPIER vers .env.production sur le serveur et à remplir. NE JAMAIS COMMITTER.
# Génération d'un secret : openssl rand -base64 36
DOMAIN=exemple-lsv.fr
ACME_EMAIL=contact@exemple-lsv.fr
NEXT_PUBLIC_SITE_URL=https://exemple-lsv.fr

POSTGRES_USER=lsv
POSTGRES_PASSWORD=
POSTGRES_DB=lsv
DATABASE_URL=postgres://lsv:<POSTGRES_PASSWORD>@db:5432/lsv

APP_SECRET=                       # >= 32 caractères aléatoires

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=LSV <no-reply@exemple-lsv.fr>
ADMIN_NOTIFY_EMAIL=

# Initialisation unique (profil « bootstrap »). Supprimer ces 2 lignes ensuite.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

REQUEST_RETENTION_MONTHS=12       # À VALIDER avec le client / DPO

# Sauvegardes restic (chiffrées, dédupliquées). Le dépôt doit être HORS du serveur en production.
# Exemples de RESTIC_REPOSITORY : s3:s3.fr-par.scw.cloud/lsv-sauvegardes · b2:lsv-sauvegardes:db
#   rest:https://user:pass@hote:8000/lsv   (serveur rest-server, idéalement en ajout seul)
# Variables d'accès du fournisseur (selon le cas) : AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, B2_ACCOUNT_ID, B2_ACCOUNT_KEY…
# RESTIC_PASSWORD : openssl rand -base64 36 — À CONSERVER AUSSI HORS SERVEUR (2 copies) : sans lui, aucune restauration.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=30      # tout est gardé 30 jours…
BACKUP_KEEP_MONTHLY=12        # …puis 1 sauvegarde par mois pendant 12 mois
BACKUP_CRON=30 2 * * *
