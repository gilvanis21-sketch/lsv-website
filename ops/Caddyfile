# Reverse proxy : HTTPS automatique (Let's Encrypt), redirection HTTP -> HTTPS native.
{
	email {$ACME_EMAIL:admin@example.invalid}
}

{$DOMAIN} {
	encode zstd gzip
	header -Server
	reverse_proxy app:3000 {
		health_uri /api/health
		health_interval 30s
	}
	log {
		output stdout
		format json
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
